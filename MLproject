# MLflow Project: identical, reproducible entry points for development and test environments.
#   mlflow run . -e test --env-manager local --experiment-name diabetes-risk
# Always pass --experiment-name diabetes-risk (the experiment the code logs to).
name: diabetes-risk-prediction

python_env: python_env.yaml

entry_points:
  main:
    command: "dvc repro"                       # the whole DVC pipeline
  ingest:
    command: "python -m src.data.ingest"
  eda:
    command: "python scripts/eda.py"
  process:
    command: "python -m src.data.process"
  train:
    command: "python -m src.models.train"
  evaluate:
    command: "python -m src.models.evaluate"
  drift:
    command: "python -m src.monitoring.drift_monitor"
  drift_retrain:
    command: "python -m src.monitoring.drift_monitor --retrain"
  test:
    command: "python scripts/run_tests.py"
